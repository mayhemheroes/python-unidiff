# Mayhem target: python-unidiff unified-diff parser (Atheris/libFuzzer harness).
# The cmd binary is the compiled ELF launcher that drives mayhem/fuzz_diff.py; Atheris instruments
# the unidiff library so the run records coverage (edges). Mirrors the fork's original `fuzz-diff`
# target (PatchSet.from_filename on a fuzzer-generated .diff).
project: python-unidiff
target: fuzz-diff

cmds:
  - cmd: /mayhem/fuzz_diff
    libfuzzer: true

# Seed corpus of representative unified diffs (file:// URIs, per the Mayhemfile schema).
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz-diff/testsuite
